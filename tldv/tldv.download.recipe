<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest version of tl;dv.

Set ARCH to an empty string for the Intel build (default) or to "-arm64" for the Apple Silicon build.</string>
	<key>Identifier</key>
	<string>com.github.wycomco.download.tldv</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>tldv</string>
		<key>ARCH</key>
		<string></string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>https://releases.tldv.io/latest-mac.yml</string>
				<key>re_pattern</key>
				<string>url: (?P&lt;filename&gt;tldv-(?P&lt;version&gt;[\d.]+)%ARCH%\.dmg)</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>URLDownloader</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>https://releases.tldv.io/%filename%</string>
				<key>filename</key>
				<string>%NAME%-%version%%ARCH%.dmg</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%/tldv.app</string>
				<key>requirement</key>
				<string>identifier "io.tldv.desktop" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = WDASY37SGG</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
